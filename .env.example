# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Bearer token for /api/cron/* routes (required in production)
CRON_SECRET=

# Optional default company for cron routes when companyId is omitted
# DEFAULT_COMPANY_ID=

# ── Worker intervals (milliseconds) ──────────────────────────────────────────
PIPELINE_INTERVAL_MS=3600000
REFLECTION_INTERVAL_MS=86400000

# ── Clerk ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Optional Clerk redirect paths (defaults shown)
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/onboarding
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# Transaction pooler — used by the app and worker at runtime (port 6543)
DATABASE_URL=

# Direct connection — used by migrations and drizzle-kit (port 5432)
# Falls back to DATABASE_URL when unset
DATABASE_DIRECT_URL=

# ── Composio ─────────────────────────────────────────────────────────────────
COMPOSIO_API_KEY=

# Optional: override auto-discovered Composio auth config IDs per toolkit
# COMPOSIO_AUTH_CONFIG_SLACK=
# COMPOSIO_AUTH_CONFIG_GITHUB=
# COMPOSIO_AUTH_CONFIG_LINEAR=

# ── Hindsight ────────────────────────────────────────────────────────────────
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=

# Parent key must allow creating scoped child keys
HINDSIGHT_SCOPED_KEY_EXPIRES_IN_DAYS=365

# ── Gemini (extraction) ─────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
